{
  "name": "Streamify - Telegram Auth (Lógica Iterativa)",
  "nodes": [
    {
      "parameters": {},
      "name": "Webhook Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "telegram-auth-streamify",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot Streamify"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Extraer datos del mensaje de Telegram\nconst chatId = $input.item.json.message.chat.id;\nconst messageText = $input.item.json.message.text || '';\nconst firstName = $input.item.json.message.from.first_name || '';\nconst lastName = $input.item.json.message.from.last_name || '';\nconst username = $input.item.json.message.from.username || '';\n\nreturn {\n  chat_id: chatId,\n  message: messageText.trim(),\n  user_info: {\n    first_name: firstName,\n    last_name: lastName,\n    username: username,\n    full_name: `${firstName} ${lastName}`.trim()\n  }\n};"
      },
      "name": "Extraer Datos",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://streamify.aaronsoft.es/api/telegram/check-registered",
        "authentication": "none",
        "options": {},
        "headerParametersJson": "{\n  \"Content-Type\": \"application/json\",\n  \"Accept\": \"application/json\"\n}",
        "bodyParametersJson": "={\n  \"chat_id\": {{ $json.chat_id }}\n}"
      },
      "name": "Verificar Registro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.registrado }}",
              "value2": true
            }
          ]
        }
      },
      "name": "¿Ya Registrado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Extraer Datos\"].json.chat_id }}",
        "text": "=✅ ¡Hola {{ $node[\"Extraer Datos\"].json.user_info.first_name }}!\n\nTu cuenta ya está vinculada.\n\n👤 Nombre: {{ $json.cliente.nombre }}\n📧 Email: {{ $json.cliente.email }}\n\nYa puedes usar todas las funciones del bot. Escribe /ayuda para ver los comandos disponibles."
      },
      "name": "Respuesta Ya Registrado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1050, 200],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot Streamify"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://streamify.aaronsoft.es/api/telegram/process-input",
        "authentication": "none",
        "options": {},
        "headerParametersJson": "{\n  \"Content-Type\": \"application/json\",\n  \"Accept\": \"application/json\"\n}",
        "bodyParametersJson": "={\n  \"chat_id\": {{ $node[\"Extraer Datos\"].json.chat_id }},\n  \"message\": \"{{ $node[\"Extraer Datos\"].json.message }}\"\n}"
      },
      "name": "Procesar Entrada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Extraer Datos\"].json.chat_id }}",
        "text": "={{ $json.mensaje }}"
      },
      "name": "Enviar Respuesta Auth",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1250, 400],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot Streamify"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.auth_complete }}",
              "value2": true
            }
          ]
        }
      },
      "name": "¿Auth Completado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Extraer Datos\"].json.chat_id }}",
        "text": "=🎉 ¡Registro completado con éxito!\n\n👤 {{ $json.cliente.nombre }}\n📧 {{ $json.cliente.email }}\n\nAhora puedes usar todas las funciones:\n\n/saldo - Ver tu saldo\n/comprar - Comprar servicio\n/renovar - Renovar servicio\n/miscuentas - Ver tus cuentas activas\n/soporte - Contactar soporte\n/ayuda - Ver todos los comandos"
      },
      "name": "Mensaje Bienvenida",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1650, 300],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot Streamify"
        }
      }
    }
  ],
  "connections": {
    "Webhook Telegram": {
      "main": [
        [
          {
            "node": "Extraer Datos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer Datos": {
      "main": [
        [
          {
            "node": "Verificar Registro",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar Registro": {
      "main": [
        [
          {
            "node": "¿Ya Registrado?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Ya Registrado?": {
      "main": [
        [
          {
            "node": "Respuesta Ya Registrado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Procesar Entrada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Procesar Entrada": {
      "main": [
        [
          {
            "node": "Enviar Respuesta Auth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Respuesta Auth": {
      "main": [
        [
          {
            "node": "¿Auth Completado?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Auth Completado?": {
      "main": [
        [
          {
            "node": "Mensaje Bienvenida",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
