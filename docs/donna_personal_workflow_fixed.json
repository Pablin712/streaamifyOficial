      "parameters": {
        "jsCode": "const message = $input.item.json.message || {};\n\nconst chatId = String(message?.chat?.id || '');\nconst rawText = message?.text || '';\nconst text = rawText.trim();\nconst voiceFileId = message?.voice?.file_id || null;\nconst username = message?.from?.username || null;\nconst name = [message?.from?.first_name, message?.from?.last_name]\n  .filter(Boolean)\n  .join(' ') || 'Usuario';\n\nconst normalizedText = text.toUpperCase();\nconst isActivationCode = /^[A-Z0-9]{6}$/.test(normalizedText);\n\nreturn [{\n  json: {\n    telegram_chat_id: chatId,\n    text,\n    voice_file_id: voiceFileId,\n    telegram_username: username,\n    telegram_name: name,\n    activation_code: isActivationCode ? normalizedText : null,\n    is_activation_code: isActivationCode,\n    is_audio: !!voiceFileId,\n    is_text: !!text && !isActivationCode,\n    original_update: $input.item.json\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
