            },
            {
              "name": "mensaje",
              "value": "={{$json.message.conversation ?? $json.message.extendedTextMessage.text ?? ''}}"
            },
            {
              "name": "tipo",
              "value": "={{Object.keys($json.message)[0] === 'imageMessage' ? 'imagen' : Object.keys($json.message)[0] === 'audioMessage' ? 'audio' : 'texto'}}"
            },
            {
              "name": "media_url",
              "value": "={{$json.message.imageMessage?.url ?? $json.message.audioMessage?.url}}"
            },
            {
              "name": "mime_type",
              "value": "={{$json.message.imageMessage?.mimetype ?? $json.message.audioMessage?.mimetype}}"
            },
