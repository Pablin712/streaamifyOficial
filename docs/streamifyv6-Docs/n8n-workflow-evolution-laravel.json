        "bodyParametersUi": {
          "parameter": [
            {
              "name": "number",
              "value": "={{$json.numero.replace('@s.whatsapp.net', '')}}"
            },
            {
              "name": "mediatype",
              "value": "={{$json.tipo_contenido === 'imagen' ? 'image' : 'audio'}}"
            },
            {
              "name": "media",
              "value": "={{$json.media_url}}"
            }
          ]
        },
        "headerParametersUi": {
          "parameter": [
            {
              "name": "apikey",
              "value": "={{$json.instance_apikey}}"
            }
          ]
        }
      },
