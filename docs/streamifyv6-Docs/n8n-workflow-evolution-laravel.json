      "typeVersion": 4,
      "position": [
        0,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "value1": "={{$json.tipo_contenido}}",
              "operation": "equal",
              "value2": "texto"
            }
          ],
          "combineOperation": "AND"
        }
      },
